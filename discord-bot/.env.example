# Token do bot, pega em https://discord.com/developers/applications > sua app > Bot > Reset Token
DISCORD_TOKEN=

# Application ID, mesma tela do Bot (ou em General Information > Application ID)
DISCORD_CLIENT_ID=

# Opcional: ID do servidor (clique direito no ícone do servidor > Copiar ID, com
# Modo de Desenvolvedor ativado nas configs do Discord). Com isso os comandos
# aparecem na hora nesse servidor; sem isso viram comandos globais (demoram até
# 1h pra aparecer, mas funcionam em qualquer servidor que o bot entrar).
DISCORD_GUILD_ID=

# Mesmo projeto Supabase do SonorHub. Pega em Project Settings > API.
# ATENÇÃO: é a service_role key (secreta, plena de acesso) — nunca a anon key,
# e nunca comitar isso no git. O bot roda só no servidor, não expõe pra ninguém.
SUPABASE_URL=https://xtdydmfxqxsujrqdtrkn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Opcional, só pro /youtube tocar: caminho pro cookies.txt exportado de uma
# conta logada do YouTube (extensão tipo "Get cookies.txt LOCALLY" ou
# J2TEAM Cookies, formato Netscape). Sem isso o YouTube costuma bloquear
# extração de IP de VPS/datacenter com "Sign in to confirm you're not a
# bot" — /radio (rádio de verdade) não precisa disso, só funciona sem
# cookie nenhum. Esses cookies rotacionam de tempos em tempos (proteção do
# Google) — quando voltar o erro de "sign in", exporta de novo.
YOUTUBE_COOKIES_FILE=

# Também requer o binário "deno" instalado no PATH do sistema (resolve o
# desafio de assinatura/JS do YouTube) — sem ele o yt-dlp falha com
# "Signature solving failed" mesmo com cookies válidos.

# Opcional: chave da YouTube Data API v3 (Google Cloud Console, sem OAuth,
# só uma API key mesmo). Usada só pra BUSCA por nome (/youtube tocar "nxzero"
# em vez de um link) — sem ela a busca cai pro yt-dlp (ytsearch), que também
# funciona mas usa a mesma conta dos cookies acima. Com a chave configurada,
# a extração do áudio (yt-dlp+cookies) continua sendo a única parte que
# depende da conta — a busca em si não gasta cookie nenhum.
YOUTUBE_API_KEY=

# Opcional: lista (separada por vírgula, sem espaço) dos IDs dos servidores
# onde o /youtube (extração de áudio) fica liberado. Qualquer servidor fora
# dessa lista (ex: convidado por terceiros) só tem /radio. Sem essa
# variável, usa o default hardcoded em src/config.js.
YOUTUBE_GUILD_IDS=170887646363648000,840941809059364904,1548131076130742304,1415370456516657223
